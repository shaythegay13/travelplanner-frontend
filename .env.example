# Copy to .env.local for local dev, and set these in the Vercel project settings.

# Required for /api/trip and /api/profile. Without it both return 501.
ANTHROPIC_API_KEY=

# Required for /api/profile — the optional "import my preferences" step on the
# account screen. Without it the route returns 501 and the account screen still
# works; the user just picks priorities by hand.
TAVILY_API_KEY=

# Optional. Without it /api/speak returns 501 and the component falls back to
# browser speech synthesis on its own.
ELEVENLABS_API_KEY=
# Optional voice override; defaults to a stock ElevenLabs voice.
ELEVENLABS_VOICE_ID=

# Optional. Stay22 is called from the browser and runs in demo mode with no key.
# To use one, set STAY22.apiKey and STAY22.aid at the top of
# src/components/GroupTripPlanner.jsx — `aid` is what earns the commission.
STAY22_API_KEY=
